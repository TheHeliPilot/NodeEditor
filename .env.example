# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=
# The server (guild) the bot works in. Right-click server -> Copy Server ID
GUILD_ID=

# Set to false if you don't enable the "Server Members" privileged intent.
# Without it, D1/D7/D30 retention uses the first time a user was seen instead of their join date.
MEMBERS_INTENT=true

# Web admin panel
PORT=3000
# Public address of the panel, used in invite links (no trailing slash)
PUBLIC_URL=http://localhost:3000

# Where the SQLite database lives
DB_PATH=./data/bot.db
# Calendar days for statistics are counted in this time zone
TIMEZONE=Europe/Bratislava
