<%- include('partials/head', { pageTitle: 'Admini' }) %>
<% const fmt = ms => ms ? new Date(ms).toLocaleString('sk', { day: 'numeric', month: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '–'; %>
<header class="page-head">
  <div>
    <h1>Admini</h1>
    <p class="sub">Nového admina pridáš jednorazovým prihlasovacím odkazom</p>
  </div>
</header>

<% if (newInvite) { %>
<section class="panel invite-new">
  <h2>Nový prihlasovací odkaz</h2>
  <p class="fine">Pošli ho jednému človeku. Platí <%= hours %> hodín a dá sa použiť raz.</p>
  <div class="copy">
    <input readonly value="<%= publicUrl %>/invite/<%= newInvite %>" id="invite-url">
    <button class="btn primary" type="button" data-copy="#invite-url">Kopírovať</button>
  </div>
</section>
<% } %>

<form class="toolbar add" method="post" action="/admins/invites">
  <input name="note" placeholder="Pre koho? (nepovinné, napr. Marek)" maxlength="60">
  <button class="btn primary" type="submit">Vytvoriť prihlasovací odkaz</button>
</form>

<div class="table-wrap">
<table class="data">
  <thead><tr><th>Meno</th><th>Pridal</th><th>Vytvorený</th><th>Posledné prihlásenie</th><th></th></tr></thead>
  <tbody>
  <% for (const a of admins) { %>
    <tr>
      <td><strong><%= a.username %></strong><% if (a.id === admin.id) { %> <span class="chip">ty</span><% } %></td>
      <td class="muted"><%= a.created_by_name || 'prvý admin' %></td>
      <td class="num muted"><%= fmt(a.created_at) %></td>
      <td class="num muted"><%= fmt(a.last_login_at) %></td>
      <td class="r"><% if (a.id !== admin.id) { %>
        <form method="post" action="/admins/<%= a.id %>/delete" data-confirm="Odstrániť admina <%= a.username %>?"><button class="btn quiet danger" type="submit">Odstrániť</button></form>
      <% } %></td>
    </tr>
  <% } %>
  </tbody>
</table>
</div>

<% if (invites.length) { %>
<h2 class="section-title">Nepoužité odkazy</h2>
<div class="table-wrap">
<table class="data">
  <thead><tr><th>Pre</th><th>Vytvoril</th><th>Platí do</th><th></th></tr></thead>
  <tbody>
  <% for (const i of invites) { %>
    <tr>
      <td><%= i.note || '–' %></td>
      <td class="muted"><%= i.created_by_name %></td>
      <td class="num muted"><%= fmt(i.expires_at) %></td>
      <td class="r"><form method="post" action="/admins/invites/<%= i.token %>/revoke"><button class="btn quiet" type="submit">Zrušiť</button></form></td>
    </tr>
  <% } %>
  </tbody>
</table>
</div>
<% } %>
<%- include('partials/foot') %>
